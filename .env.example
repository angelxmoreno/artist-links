# Copy to .env for local dev; in Dokploy set these in the app's Environment tab.
# Every variable is optional: empty = feature off.

# Goes in the MusicBrainz User-Agent (their policy requires a contact URL or email).
MUSICBRAINZ_CONTACT=https://github.com/angelxmoreno/artist-links
# Canonical/OG base URL, e.g. https://links.example.com. Empty = request origin.
SITE_URL=

# Bugsink (Sentry-compatible) DSN, used by both the server and the browser.
SENTRY_DSN=
# Environment tag in Bugsink (development, production, ...). Empty = NODE_ENV.
SENTRY_ENVIRONMENT=

# Umami analytics. The tracker only records the hostname of SITE_URL, so set SITE_URL
# in production only and local/preview visits are ignored.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
